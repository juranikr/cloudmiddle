# Copy to .env.local only when local agent/search integration is needed, then run:
# docker compose --env-file .env.local up --build -d
# Never put production DATABASE_URL or AWS credentials in this file.

AGENT_BACKEND=codex
OPENAI_API_KEY=
CODEX_MODEL=gpt-6.1-sol
CODEX_TIMEOUT_SECONDS=900
CODEX_BATCH_TIMEOUT_SECONDS=7200
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
ARCGIS_API_KEY=
BRAVE_SEARCH_API_KEY=
BRAVE_PLACE_ENABLED=true
BRAVE_SEARCH_STORAGE_RIGHTS=false
