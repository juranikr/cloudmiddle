project_name = "tourmiddle"
environment  = "dev"
aws_region   = "ap-northeast-2"

github_org  = "juranikr"
github_repo = "tourmiddle"

api_desired_count = 1
db_instance_class = "db.t4g.micro"

# 같은 오리진(CloudFront) 사용 시 * 로 충분. 커스텀 도메인 쓰면 해당 URL
cors_origins = "*"

# 비우면 자동 생성
# jwt_secret = "change-me"
