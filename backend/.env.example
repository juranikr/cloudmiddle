# 기본값: SQLite (Docker 불필요)
# DATABASE_URL=sqlite:///./jinan_travel.db

# Docker/로컬 Postgres 사용 시:
# DATABASE_URL=postgresql+psycopg2://jinan:jinan_secret@localhost:5432/jinan_travel

JWT_SECRET=change-me-in-production-jinan-travel-2026
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 안전 기본값: 사용자 작업 큐만 처리하고 자동 생성·병합은 하지 않음
AGENT_AUTONOMOUS_RESEARCH=false
AGENT_ALLOW_AUTO_CREATE=false
AGENT_ALLOW_AUTO_MERGE=false
