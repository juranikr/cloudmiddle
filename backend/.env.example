# 명시적 로컬 개발 모드. SQLite 또는 아래의 격리된 로컬 Postgres만 사용합니다.
APP_DB_MODE=local
# DATABASE_URL=sqlite:///./jinan_travel.db

# `docker compose up -d db` 후 호스트에서 API를 실행할 때:
# DATABASE_URL=postgresql+psycopg2://cloudmiddle_local:cloudmiddle_local_only@127.0.0.1:55432/cloudmiddle_local

JWT_SECRET=local-development-only-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 선택: 일반 국제 ArcGIS Location Platform 키.
# 없으면 ArcGIS 후보는 참고용으로만 표시되며 바로 DB에 저장되지 않습니다.
# ARCGIS_API_KEY=

# Optional Brave Place structured POI discovery. Without a key the existing
# multi-engine text search continues unchanged. Keep storage rights false unless
# the Brave account terms explicitly allow storing Place results.
# BRAVE_SEARCH_API_KEY=
BRAVE_PLACE_ENABLED=true
BRAVE_SEARCH_STORAGE_RIGHTS=false

# 안전 기본값: 사용자 작업 큐만 처리하고 자동 생성·병합은 하지 않음
AGENT_AUTONOMOUS_RESEARCH=false
AGENT_ALLOW_AUTO_CREATE=false
AGENT_ALLOW_AUTO_MERGE=false

# 운영 읽기 전용 진단은 별도 프로세스/셸에서만 사용합니다. 운영 앱 DATABASE_URL을
# 로컬 .env에 복사하지 말고 read-only DB 사용자 URL을 일시적으로 주입하세요.
# APP_DB_MODE=production_readonly
# DATABASE_URL=postgresql+psycopg2://READONLY_USER:REDACTED@PROD_HOST:5432/PROD_DB
# 이 모드는 DB transaction read-only, startup bootstrap 생략, HTTP 쓰기 차단을 강제합니다.
